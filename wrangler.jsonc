{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "uavmetric",
  "main": "worker.js",
  "compatibility_date": "2026-09-12",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page"
  },
  "routes": [
    {
      "pattern": "uavmetric.com",
      "custom_domain": true
    },
    {
      "pattern": "www.uavmetric.com",
      "custom_domain": true
    }
  ]
}
